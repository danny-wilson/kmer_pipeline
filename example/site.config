// Site-specific settings: everything that depends on where you're running, not on the analysis
// itself (which lives in a params file, e.g. example/tb20_nucleotide31.yaml). Copy this file,
// uncomment and edit what you need, and add it with -c:
//   nextflow run kmer_pipeline.nf -profile apptainer -params-file example/tb20_nucleotide31.yaml -c mysite.config
//
// Loaded after -params-file (Nextflow's own precedence: repo nextflow.config, then a launch-
// directory nextflow.config if present, then -c, then -params-file, then --param), so the lines
// below that reference params.maxp see whatever the params file (or --maxp on the command line)
// actually set.

// Cap the local executor at your own real concurrency. Without this, Nextflow's local executor
// queues as many tasks as your machine has cores, which can be far more than you actually want
// to run in parallel alongside anything else on a shared login node.
// executor.queueSize = params.maxp
// executor.cpus = params.maxp

// Submit to Slurm or SGE instead of running locally (also set -profile slurm / sge on the command
// line, which only sets the executor name -- queue/clusterOptions/resource requests are site-
// specific and belong here, not in nextflow.config).
// process.queue = 'short'
// process.clusterOptions = '--account=myaccount'
// executor.queueSize = params.maxp

// Where Apptainer/Singularity caches the pulled image, so it isn't re-downloaded for every run
// (and isn't left in a per-run or home-directory default that may be small or not shared across
// a cluster's nodes). Point this at shared, persistent storage.
// singularity.cacheDir = '/path/to/shared/singularity-cache'

// Extra bind mounts the container needs beyond base_dir and this repo's own directory (both
// already bound automatically) -- for example, an assembly symlinked in from elsewhere, or a
// shared reference-data store. Appended as-is to the container's own -B/-v arguments.
// params.extra_binds = ['/path/to/extra/data']
