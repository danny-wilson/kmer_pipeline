// Repo-owned pipeline configuration (PLAN.md Part B, B7; slurm/sge profiles added at Part C, C1).
// Analysis-parameter defaults stay in kmer_pipeline.nf itself (USER_KEYS, taken from
// params.keySet() before any default is assigned, relies on that); this file holds only what
// belongs to the repo: the manifest, the pinned toolchain image, and the engine/executor
// profiles. Site-specific settings (queue, clusterOptions, cacheDir, extra_binds) belong in a
// user's own -c file (example/site.config), not here.

manifest {
	mainScript = 'kmer_pipeline.nf'
	defaultBranch = 'main'
	nextflowVersion = '22.04.5'
	homePage = 'https://github.com/danny-wilson/kmer_pipeline'
	description = 'Pipeline for kmer (oligo)-based genome-wide association studies'
}

// The toolchain image, pinned by digest (Part D, D4 - the code-free img-2026-10-20 image,
// published and verified: Step 2 and the full test suite both 0 differences/0 failed against it).
// docker:// is the form apptainer needs; the docker profile strips it (checked at B0).
params.container = 'docker://dannywilson/kmer_pipeline@sha256:1f9d2c35c0fccab9391d79b10c1be4a318a5c2500cbaf0bc2e6f85065c816afb' // img-2026-10-20

// Extra bind mounts (for example, a symlink target outside base_dir): a list of "-B"/"-v"-style
// path arguments the containerOptions closures below append as-is.
params.extra_binds = []

// Pin BLAS/OpenMP threading for every invocation, not only the e2e harness's own profile runs
// (B9, guards P3/P39/P59): the goldens were made with these pinned, and an unpinned GEMMA run can
// differ numerically. env{} (not singularity.runOptions/docker.runOptions, which would replace
// the profiles' own --containall --cleanenv rather than add to it) is forwarded into the
// container regardless of --cleanenv -- confirmed directly, not assumed. Also recorded in each
// preflight run's metadata.json (dropped silently under plain --cleanenv otherwise).
env {
	OPENBLAS_NUM_THREADS = 1
	OMP_NUM_THREADS = 1
}

// A real user should also cap the local executor to their own real concurrency -- e.g.
// "params.maxp = N" then "executor.cpus = params.maxp" / "executor.queueSize = params.maxp" in
// their OWN config file, matching what tests/e2e/make_reference.sh already writes for itself and
// what this repo's own (pre-refactor) example/*.nextflow.config templates already did (verified
// directly, B9, guards P17). This can't be done generically here: Nextflow resolves a plain
// "executor.X = params.maxp" assignment using whatever params.maxp is at THIS file's own parse
// time (same reason process.container above needs a closure) -- and unlike process.container,
// executor.cpus/queueSize do NOT accept a closure at all (confirmed directly: Nextflow 22.04.5
// throws "Cannot coerce a map to class int" if given one), so there is no way to express "whatever
// the user's own maxp turns out to be" from this file. Part C's new example/site.config carries
// this pattern forward, maxp and the executor lines together in one file, same as today's.

// Bind base_dir and projectDir into the container at their own paths (identity mounts - no
// container-side path differs from its host spelling). The closure itself canonicalizes
// params.base_dir, rather than relying on anything computed in kmer_pipeline.nf: a config
// closure can only read params.*, not a script-local variable, so canonicalizing anywhere else
// would leave the bind using the user's raw (possibly symlinked) spelling while the script uses
// the canonical one, binding the wrong path. Lazy (a closure, not a plain assignment): nextflow.
// config is parsed before a site -c file or -params-file, so a plain assignment of
// process.container would lock in this digest before either could override it (guards P9).
def singularityBindArgs = {
	def b = new File(params.base_dir).canonicalPath
	def opts = "-B ${b} -B ${projectDir}"
	if(params.extra_binds) opts += params.extra_binds.collect { " -B ${it}" }.join()
	opts
}
// Guarded against base_dir canonicalizing to the same path as projectDir (the quickstart layout:
// clone the repo, run from inside it, base_dir = "."), found at plan-review (guards P37): Docker
// rejects two -v mounts with the same host and container path outright, unlike Apptainer/
// Singularity's -B, which tolerates the duplicate -- so only the docker closure needs this.
def dockerBindArgs = {
	def b = new File(params.base_dir).canonicalPath
	def pd = projectDir.toString()
	def opts = (b == pd) ? "-v ${b}:${b}" : "-v ${b}:${b} -v ${pd}:${pd}"
	if(params.extra_binds) opts += params.extra_binds.collect { " -v ${it}" }.join()
	opts
}

profiles {
	apptainer {
		singularity.enabled = true
		singularity.autoMounts = true
		singularity.runOptions = '--containall --cleanenv'
		singularity.pullTimeout = '2h' // the base toolchain image is ~1.9GB; the 20-min default may be tight on a slow link
		process.container = { params.container }
		process.containerOptions = singularityBindArgs
	}
	singularity {
		singularity.enabled = true
		singularity.autoMounts = true
		singularity.runOptions = '--containall --cleanenv'
		singularity.pullTimeout = '2h'
		process.container = { params.container }
		process.containerOptions = singularityBindArgs
	}
	docker {
		docker.enabled = true
		// Unlike Apptainer/Singularity (which always runs as the invoking host user), Docker runs
		// as the image's own default user unless told otherwise - a real bug found by actually
		// running -profile docker for real (C1's docker-smoke.yml): preflight's os.makedirs()
		// inside the container got "Permission denied" creating analysis_dir on the host-mounted
		// checkout, owned by the host user, not the image's default user. $(id -u)/$(id -g) are
		// evaluated by the shell when .command.run executes, same as the manual's own launcher
		// command.
		docker.runOptions = '-u $(id -u):$(id -g)'
		// params.container's docker:// scheme prefix (needed by Apptainer/Singularity, which can
		// also pull from other schemes) is not valid for Docker's own CLI ("docker: invalid
		// reference format") - a real bug found by docker-smoke.yml's first run against the real
		// pinned default (D4): every earlier -profile docker test passed an explicit --container
		// override with no prefix to strip, so this was never actually exercised before. Stripped
		// here, not at params.container's own definition, since the apptainer/singularity
		// profiles need the prefix kept.
		process.container = { params.container.toString().replaceFirst(/^docker:\/\//, '') }
		process.containerOptions = dockerBindArgs
	}
	// Executor only (C1): combine with apptainer/docker on the command line, e.g.
	// -profile apptainer,slurm. Queue/clusterOptions/resource requests are site-specific and
	// belong in a -c file (example/site.config), not here.
	slurm {
		process.executor = 'slurm'
	}
	sge {
		process.executor = 'sge'
	}
}
