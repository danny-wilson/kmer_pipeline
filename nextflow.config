// Repo-owned pipeline configuration (PLAN.md Part B, B7). Analysis-parameter defaults stay in
// kmer_pipeline.nf itself (USER_KEYS, taken from params.keySet() before any default is assigned,
// relies on that); this file holds only what belongs to the repo: the manifest, the pinned
// toolchain image, and the container-engine profiles. Executor profiles (slurm, sge) and the
// user-facing example params files come in Part C.

manifest {
	mainScript = 'kmer_pipeline.nf'
	defaultBranch = 'main'
	nextflowVersion = '22.04.5'
	homePage = 'https://github.com/danny-wilson/kmer_pipeline'
	description = 'Pipeline for kmer (oligo)-based genome-wide association studies'
}

// The toolchain image, pinned by digest. For now (before Part D publishes a code-free img-*
// image and a later PR pins it) this is the existing, published, code-full 2026-10-06 image, so
// that --container has a working default rather than none at all. docker:// is the form apptainer
// needs; the docker profile strips it (checked at B0).
params.container = 'docker://dannywilson/kmer_pipeline@sha256:d89009f3e532e964637af6f45c4b5ed0f953881ec0d7cbbf80673ce1b44f5d06' // 2026-10-06

// Extra bind mounts (for example, a symlink target outside base_dir): a list of "-B"/"-v"-style
// path arguments the containerOptions closures below append as-is.
params.extra_binds = []

// Bind base_dir and projectDir into the container at their own paths (identity mounts - no
// container-side path differs from its host spelling). The closure itself canonicalizes
// params.base_dir, rather than relying on anything computed in kmer_pipeline.nf: a config
// closure can only read params.*, not a script-local variable, so canonicalizing anywhere else
// would leave the bind using the user's raw (possibly symlinked) spelling while the script uses
// the canonical one, binding the wrong path. Lazy (a closure, not a plain assignment): nextflow.
// config is parsed before a site -c file or -params-file, so a plain assignment of
// process.container would lock in this digest before either could override it (guards P9).
def singularityBindArgs = {
	def b = new File(params.base_dir).canonicalPath
	def opts = "-B ${b} -B ${projectDir}"
	if(params.extra_binds) opts += params.extra_binds.collect { " -B ${it}" }.join()
	opts
}
def dockerBindArgs = {
	def b = new File(params.base_dir).canonicalPath
	def opts = "-v ${b}:${b} -v ${projectDir}:${projectDir}"
	if(params.extra_binds) opts += params.extra_binds.collect { " -v ${it}" }.join()
	opts
}

profiles {
	apptainer {
		singularity.enabled = true
		singularity.autoMounts = true
		singularity.runOptions = '--containall --cleanenv'
		singularity.pullTimeout = '2h' // the base toolchain image is ~1.9GB; the 20-min default may be tight on a slow link
		process.container = { params.container }
		process.containerOptions = singularityBindArgs
	}
	singularity {
		singularity.enabled = true
		singularity.autoMounts = true
		singularity.runOptions = '--containall --cleanenv'
		singularity.pullTimeout = '2h'
		process.container = { params.container }
		process.containerOptions = singularityBindArgs
	}
	docker {
		docker.enabled = true
		process.container = { params.container }
		process.containerOptions = dockerBindArgs
	}
}
